{
  "name": "linggo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"tsx watch src/server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "policy:check": "node --import tsx scripts/check-engineering-policy.ts",
    "duplicates": "jscpd src/client src/server src/shared --config config/jscpd.json --format typescript,tsx --exit-code 1",
    "github:ruleset:audit": "node --import tsx scripts/github-ruleset.ts",
    "github:ruleset:apply": "node --import tsx scripts/github-ruleset.ts --apply",
    "verify:fast": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm policy:check && pnpm duplicates && pnpm test",
    "verify": "pnpm verify:fast && pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "research:run": "node --import tsx scripts/research-run.ts",
    "research:analyze": "node --import tsx scripts/research-analyze.ts",
    "research:validate": "node --import tsx scripts/research-validate.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.41",
    "@ai-sdk/google": "4.0.50",
    "@ai-sdk/openai": "4.0.46",
    "@ai-sdk/openai-compatible": "3.0.35",
    "@fastify/static": "10.1.3",
    "@sabaki/go-board": "1.4.3",
    "@sabaki/sgf": "3.5.0",
    "@sabaki/shudan": "1.8.0",
    "@tanstack/react-query": "5.102.2",
    "ai": "7.0.77",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.1",
    "i18next": "26.4.0",
    "lucide-react": "1.33.0",
    "preact": "10.29.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.12",
    "react-router-dom": "7.18.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "concurrently": "10.0.5",
    "eslint": "10.9.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "husky": "9.1.7",
    "jscpd": "5.1.0",
    "lint-staged": "17.4.1",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --check",
      "eslint"
    ],
    "*.{css,json,md,mjs,yml,yaml}": "prettier --check"
  },
  "packageManager": "pnpm@11.21.0"
}
